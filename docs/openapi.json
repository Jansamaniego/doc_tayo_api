{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "operationId": "AuthController_signIn_v1",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Access token, user and memberships. The refresh token is set in an HttpOnly cookie, never in the body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "INVALID_CREDENTIALS"
          },
          "429": {
            "description": "RATE_LIMITED (see Retry-After)"
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "operationId": "AuthController_refreshSession_v1",
        "parameters": [],
        "responses": {
          "200": {
            "description": "A new access token; the cookie is rotated.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefreshEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHENTICATED"
          },
          "429": {
            "description": "RATE_LIMITED (see Retry-After)"
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "AuthController_logout_v1",
        "parameters": [],
        "responses": {
          "204": {
            "description": "The current session is revoked."
          },
          "429": {
            "description": "RATE_LIMITED (see Retry-After)"
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/logout-all": {
      "post": {
        "operationId": "AuthController_logoutAll_v1",
        "parameters": [],
        "responses": {
          "204": {
            "description": "Every session of the user is revoked."
          },
          "429": {
            "description": "RATE_LIMITED (see Retry-After)"
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/switch-tenant": {
      "post": {
        "operationId": "AuthController_switchActiveTenant_v1",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SwitchTenantDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The new active clinic and the permissions held there. Applies from the next request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SwitchTenantEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "RATE_LIMITED (see Retry-After)"
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/password/forgot": {
      "post": {
        "operationId": "AuthController_forgotPassword_v1",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ForgotPasswordDto"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Always 202, whether or not the email has an account (no enumeration).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AcceptedEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "RATE_LIMITED (see Retry-After)"
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/password/reset": {
      "post": {
        "operationId": "AuthController_resetPassword_v1",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResetPasswordDto"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Password set; every session of the user is revoked."
          },
          "400": {
            "description": "TOKEN_INVALID or VALIDATION_FAILED"
          },
          "429": {
            "description": "RATE_LIMITED (see Retry-After)"
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/account/setup": {
      "post": {
        "operationId": "AuthController_setUpAccount_v1",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccountSetupDto"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Account activated; sign in next."
          },
          "400": {
            "description": "TOKEN_INVALID or VALIDATION_FAILED"
          },
          "429": {
            "description": "RATE_LIMITED (see Retry-After)"
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/invitations/accept": {
      "post": {
        "operationId": "InvitationAcceptanceController_accept_v1",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AcceptInvitationDto"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Joined the clinic. Sign in next (no automatic sign-in)."
          },
          "400": {
            "description": "TOKEN_INVALID or VALIDATION_FAILED"
          },
          "403": {
            "description": "TENANT_SUSPENDED or TENANT_DEACTIVATED"
          }
        },
        "tags": [
          "invitations"
        ]
      }
    },
    "/api/v1/tenant": {
      "get": {
        "operationId": "TenantController_get_v1",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The active clinic.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TenantEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHENTICATED"
          },
          "403": {
            "description": "FORBIDDEN, TENANT_NOT_SELECTED, TENANT_SUSPENDED, TENANT_DEACTIVATED or TENANT_ACCESS_DENIED"
          }
        },
        "tags": [
          "tenant"
        ]
      },
      "patch": {
        "operationId": "TenantController_update_v1",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateTenantDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated clinic.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TenantEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHENTICATED"
          },
          "403": {
            "description": "FORBIDDEN, TENANT_NOT_SELECTED, TENANT_SUSPENDED, TENANT_DEACTIVATED or TENANT_ACCESS_DENIED"
          }
        },
        "tags": [
          "tenant"
        ]
      }
    },
    "/api/v1/branches": {
      "get": {
        "operationId": "BranchesController_list_v1",
        "parameters": [
          {
            "name": "page",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "default": 1,
              "type": "number"
            }
          },
          {
            "name": "pageSize",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "type": "number"
            }
          },
          {
            "name": "isActive",
            "required": false,
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BranchListEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHENTICATED"
          },
          "403": {
            "description": "FORBIDDEN, TENANT_NOT_SELECTED, TENANT_SUSPENDED, TENANT_DEACTIVATED or TENANT_ACCESS_DENIED"
          }
        },
        "tags": [
          "branches"
        ]
      },
      "post": {
        "operationId": "BranchesController_create_v1",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBranchDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BranchEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHENTICATED"
          },
          "403": {
            "description": "FORBIDDEN, TENANT_NOT_SELECTED, TENANT_SUSPENDED, TENANT_DEACTIVATED or TENANT_ACCESS_DENIED"
          },
          "409": {
            "description": "CONFLICT_UNIQUE: the name is taken in this clinic."
          }
        },
        "tags": [
          "branches"
        ]
      }
    },
    "/api/v1/branches/{branchId}": {
      "get": {
        "operationId": "BranchesController_get_v1",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BranchEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHENTICATED"
          },
          "403": {
            "description": "FORBIDDEN, TENANT_NOT_SELECTED, TENANT_SUSPENDED, TENANT_DEACTIVATED or TENANT_ACCESS_DENIED"
          },
          "404": {
            "description": "NOT_FOUND (also for another clinic's branch)."
          }
        },
        "tags": [
          "branches"
        ]
      },
      "patch": {
        "operationId": "BranchesController_update_v1",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateBranchDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BranchEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHENTICATED"
          },
          "403": {
            "description": "FORBIDDEN, TENANT_NOT_SELECTED, TENANT_SUSPENDED, TENANT_DEACTIVATED or TENANT_ACCESS_DENIED"
          },
          "404": {
            "description": "NOT_FOUND (also for another clinic's branch)."
          },
          "409": {
            "description": "CONFLICT_UNIQUE: the name is taken in this clinic."
          }
        },
        "tags": [
          "branches"
        ]
      }
    },
    "/api/v1/me": {
      "get": {
        "operationId": "MeController_get_v1",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The profile, the active clinic and the permissions held there.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeProfileEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHENTICATED"
          }
        },
        "tags": [
          "me"
        ]
      }
    },
    "/api/v1/me/password": {
      "post": {
        "operationId": "MeController_changePassword_v1",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordDto"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Password changed. Other sessions are revoked; this one stays signed in."
          },
          "401": {
            "description": "UNAUTHENTICATED"
          }
        },
        "tags": [
          "me"
        ]
      }
    },
    "/api/v1/me/memberships": {
      "get": {
        "operationId": "MeController_memberships_v1",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Every clinic the user belongs to (removed memberships excluded).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MembershipListEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHENTICATED"
          }
        },
        "tags": [
          "me"
        ]
      }
    },
    "/api/v1/me/sessions": {
      "get": {
        "operationId": "MeController_sessions_v1",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Active sessions; the current one is flagged.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionListEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHENTICATED"
          }
        },
        "tags": [
          "me"
        ]
      }
    },
    "/api/v1/me/sessions/{sessionId}": {
      "delete": {
        "operationId": "MeController_revokeSession_v1",
        "parameters": [],
        "responses": {
          "204": {
            "description": "The session is revoked."
          },
          "401": {
            "description": "UNAUTHENTICATED"
          },
          "404": {
            "description": "NOT_FOUND (also for someone else's session)."
          }
        },
        "tags": [
          "me"
        ]
      }
    },
    "/api/v1/invitations": {
      "post": {
        "operationId": "InvitationsController_create_v1",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateInvitationDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvitationEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHENTICATED"
          },
          "403": {
            "description": "FORBIDDEN, TENANT_NOT_SELECTED, TENANT_SUSPENDED, TENANT_DEACTIVATED or TENANT_ACCESS_DENIED"
          },
          "404": {
            "description": "NOT_FOUND (also for another clinic's role)."
          },
          "409": {
            "description": "CONFLICT (already a member) or CONFLICT_UNIQUE (an open invitation exists: resend it)."
          },
          "422": {
            "description": "ROLE_NOT_ASSIGNABLE (owner)."
          }
        },
        "tags": [
          "invitations"
        ]
      }
    },
    "/api/v1/invitations/{invitationId}/resend": {
      "post": {
        "operationId": "InvitationsController_resend_v1",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvitationEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHENTICATED"
          },
          "403": {
            "description": "FORBIDDEN, TENANT_NOT_SELECTED, TENANT_SUSPENDED, TENANT_DEACTIVATED or TENANT_ACCESS_DENIED"
          },
          "404": {
            "description": "NOT_FOUND (also for another clinic's invitation)."
          },
          "409": {
            "description": "CONFLICT: already accepted or revoked."
          }
        },
        "tags": [
          "invitations"
        ]
      }
    },
    "/api/health": {
      "get": {
        "operationId": "HealthController_live",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The process is alive.",
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "status": "ok"
                  }
                }
              }
            }
          }
        },
        "tags": [
          "health"
        ]
      }
    },
    "/api/health/ready": {
      "get": {
        "operationId": "HealthController_ready",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The service can reach PostgreSQL.\n\nThe Health Check is successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok",
                        "degraded"
                      ],
                      "example": "ok"
                    },
                    "info": {
                      "type": "object",
                      "example": {
                        "database": {
                          "status": "up",
                          "responseTime": 12
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string",
                            "enum": [
                              "up",
                              "degraded",
                              "down"
                            ]
                          },
                          "responseTime": {
                            "type": "number",
                            "description": "Time the health indicator took to respond, in ms"
                          }
                        },
                        "additionalProperties": true
                      },
                      "nullable": true
                    },
                    "error": {
                      "type": "object",
                      "example": {},
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string",
                            "enum": [
                              "up",
                              "degraded",
                              "down"
                            ]
                          },
                          "responseTime": {
                            "type": "number",
                            "description": "Time the health indicator took to respond, in ms"
                          }
                        },
                        "additionalProperties": true
                      },
                      "nullable": true
                    },
                    "details": {
                      "type": "object",
                      "example": {
                        "database": {
                          "status": "up",
                          "responseTime": 12
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string",
                            "enum": [
                              "up",
                              "degraded",
                              "down"
                            ]
                          },
                          "responseTime": {
                            "type": "number",
                            "description": "Time the health indicator took to respond, in ms"
                          }
                        },
                        "additionalProperties": true
                      }
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "PostgreSQL is unreachable (standard error shape, NOT_READY).\n\nThe Health Check is not successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "error",
                        "shutting_down"
                      ],
                      "example": "error"
                    },
                    "info": {
                      "type": "object",
                      "example": {
                        "database": {
                          "status": "up",
                          "responseTime": 12
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string",
                            "enum": [
                              "up",
                              "degraded",
                              "down"
                            ]
                          },
                          "responseTime": {
                            "type": "number",
                            "description": "Time the health indicator took to respond, in ms"
                          }
                        },
                        "additionalProperties": true
                      },
                      "nullable": true
                    },
                    "error": {
                      "type": "object",
                      "example": {
                        "redis": {
                          "status": "down",
                          "message": "Could not connect",
                          "responseTime": 3005
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string",
                            "enum": [
                              "up",
                              "degraded",
                              "down"
                            ]
                          },
                          "responseTime": {
                            "type": "number",
                            "description": "Time the health indicator took to respond, in ms"
                          }
                        },
                        "additionalProperties": true
                      },
                      "nullable": true
                    },
                    "details": {
                      "type": "object",
                      "example": {
                        "database": {
                          "status": "up",
                          "responseTime": 12
                        },
                        "redis": {
                          "status": "down",
                          "message": "Could not connect",
                          "responseTime": 3005
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string",
                            "enum": [
                              "up",
                              "degraded",
                              "down"
                            ]
                          },
                          "responseTime": {
                            "type": "number",
                            "description": "Time the health indicator took to respond, in ms"
                          }
                        },
                        "additionalProperties": true
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "tags": [
          "health"
        ]
      }
    }
  },
  "info": {
    "title": "DocTayo API",
    "description": "Clinic management backend. Errors use { error: { status, code, message, details?, requestId } }.",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "doctor@clinic.example"
          },
          "password": {
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "UserSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "example": "doctor@clinic.example"
          },
          "fullName": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "fullName"
        ]
      },
      "MembershipResponse": {
        "type": "object",
        "properties": {
          "tenantId": {
            "type": "string",
            "format": "uuid"
          },
          "tenantName": {
            "type": "string",
            "example": "Sunrise Clinic"
          },
          "tenantStatus": {
            "type": "string",
            "enum": [
              "active",
              "suspended",
              "deactivated"
            ]
          },
          "membershipStatus": {
            "type": "string",
            "enum": [
              "invited",
              "active",
              "suspended",
              "removed"
