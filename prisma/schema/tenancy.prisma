// Tenants and everything owned by a tenant. Every tenant-owned model has
// `tenantId` and `@@unique([tenantId, id])`; relations between two tenant-owned
// models are composite ([tenantId, xId] -> [tenantId, id]) so a row in one
// tenant physically cannot reference a row in another (plans/01-multitenancy.md §4.3).

enum TenantStatus {
  active
  suspended
  deactivated

  @@map("tenant_status")
}

enum MembershipStatus {
  invited
  active
  suspended
  removed

  @@map("membership_status")
}

model Tenant {
  id           String       @id @default(uuid(7)) @db.Uuid
  name         String
  slug         String       @unique
  status       TenantStatus @default(active)
  timezone     String       @default("Asia/Manila")
  contactEmail String?      @map("contact_email")
  contactPhone String?      @map("contact_phone")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  branches    Branch[]
  memberships TenantMembership[]
  roles       Role[]
  auditLogs   AuditLog[]

  rolePermissions RolePermission[]
  membershipRoles MembershipRole[]

  @@map("tenants")
}

model Branch {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String
  addressLine String?  @map("address_line")
  city        String?
  province    String?
  timezone    String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@map("branches")
}

model TenantMembership {
  id        String           @id @default(uuid(7)) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  status    MembershipStatus @default(invited)
  jobTitle  String?          @map("job_title")
  joinedAt  DateTime?        @map("joined_at") @db.Timestamptz(6)
  removedAt DateTime?        @map("removed_at") @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  roles     MembershipRole[]
  auditLogs AuditLog[]

  @@unique([tenantId, id])
  @@unique([tenantId, userId])
  @@index([userId])
  @@map("tenant_memberships")
}

model Role {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String
  name      String
  isSystem  Boolean  @default(false) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  permissions RolePermission[]
  memberships MembershipRole[]

  @@unique([tenantId, id])
  @@unique([tenantId, key])
  @@map("roles")
}

model RolePermission {
  tenantId     String   @map("tenant_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  id           String   @default(uuid(7)) @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  role       Role       @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@unique([tenantId, id])
  @@map("role_permissions")
}

model MembershipRole {
  tenantId     String   @map("tenant_id") @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  id           String   @default(uuid(7)) @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  membership TenantMembership @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Restrict)
  role       Role             @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict)

  @@id([membershipId, roleId])
  @@unique([tenantId, id])
  @@map("membership_roles")
}
