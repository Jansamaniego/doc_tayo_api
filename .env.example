# Copy to .env and adjust. Never commit real secrets.
# Documented in docs/environment.md.

# --- Application ---
NODE_ENV=development
PORT=3000
# false | loopback | <number of proxy hops>
TRUST_PROXY=false

# --- Database ---
# Runtime URL: least-privilege role `doctayo_app`.
DATABASE_URL=postgresql://doctayo_app:doctayo_app_dev@localhost:5432/doc_tayo
# Migration URL: owner role `doctayo_owner`. Used by the Prisma CLI only
# (prisma.config.ts); the running API must not hold this in production.
DATABASE_MIGRATION_URL=postgresql://doctayo_owner:doctayo_owner_dev@localhost:5432/doc_tayo
DATABASE_SCHEMA=public
# disable | require | verify-full  (disable is rejected in production)
DATABASE_SSL=disable
DATABASE_POOL_MAX=10

# --- CORS ---
# Comma-separated exact origins. Empty = no cross-origin access.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Must be true for the httpOnly refresh cookie (frontend and API on one site).
CORS_ALLOW_CREDENTIALS=true

# --- Logging ---
# error | warn | log | debug | verbose
LOG_LEVEL=debug
# pretty | json
LOG_FORMAT=pretty

# --- Swagger (defaults: true outside production, false in production) ---
SWAGGER_ENABLED=true

# --- NestJS Observe (default: enabled only in production) ---
OBSERVE_ENABLED=false
OBSERVE_APP_KEY=<set-me>
OBSERVE_APP_SECRET=<set-me>

# --- Authentication (plans/02-authentication.md) ---
# REQUIRED, at least 32 characters. Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=<set-me-to-a-random-string-of-32-or-more-characters>
# JWT_ACCESS_TTL=15m          # 5m-60m
# SESSION_IDLE_TTL=14d
# SESSION_ABSOLUTE_TTL=30d    # not shorter than SESSION_IDLE_TTL
# Frontend base URL used in emailed links (required in production).
APP_PUBLIC_URL=http://localhost:5173
# Argon2id cost (OWASP baseline shown; production refuses lower values).
# ARGON2_MEMORY_KIB=19456
# ARGON2_TIME_COST=2
# ARGON2_PARALLELISM=1

# --- Mail (development: emails are only logged) ---
# log | file | memory | smtp. Production requires smtp.
MAIL_TRANSPORT=log
# MAIL_FROM=DocTayo <no-reply@example.com>   # required in production
# SMTP_URL=smtps://user:password@smtp.example.com:465
# OUTBOX_RELAY=on             # off = do not deliver queued mail from this process

# --- Docker (docker-compose.yml; all optional) ---
# Compose sets the API's own DATABASE_URL (host "postgres"), so the DATABASE_URL
# above (host "localhost") is only for running the API outside Docker.
# Override the local container passwords here. They apply on the FIRST start of
# an empty database volume (see docs/docker.md to reset it).
# DB_OWNER_PASSWORD=doctayo_owner_dev
# DB_APP_PASSWORD=doctayo_app_dev
# POSTGRES_SUPERUSER_PASSWORD=postgres
