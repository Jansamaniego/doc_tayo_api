# Copy to .env.test. Used by `npm run test:e2e`. Points at the TEST database.
NODE_ENV=test
PORT=3001
DATABASE_URL=postgresql://doctayo_app:doctayo_app_dev@localhost:5432/doc_tayo_test
DATABASE_MIGRATION_URL=postgresql://doctayo_owner:doctayo_owner_dev@localhost:5432/doc_tayo_test
DATABASE_SCHEMA=public
DATABASE_SSL=disable
DATABASE_POOL_MAX=5
CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOW_CREDENTIALS=false
LOG_LEVEL=error
LOG_FORMAT=json
SWAGGER_ENABLED=true
OBSERVE_ENABLED=false
